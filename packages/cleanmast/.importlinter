[importlinter]

root_package = cleanmast
include_external_packages = true
exclude_type_checking_imports = true

[importlinter:contract:subdomain-isolation]
name = DDD Bounded Context Isolation
type = independence
modules =
    cleanmast.subdomains.dataingestion
    cleanmast.subdomains.dataprocessing
    cleanmast.subdomains.assessment
    cleanmast.subdomains.configuration

[importlinter:contract:domain-purity]
name = Domain Layer Purity
type = forbidden
source_modules =
    cleanmast.subdomains.dataingestion.value_objects
    cleanmast.subdomains.dataingestion.entities
    cleanmast.subdomains.assessment.domain.value_objects
    cleanmast.subdomains.assessment.domain.entities
forbidden_modules =
    polars
    pandas
    sqlalchemy
    click
    cleanmast.db
    cleanmast.infrastructure

[importlinter:contract:layer-hierarchy]
name = Application Layer Dependencies
type = layers
containers = cleanmast
layers =
    application
    subdomains

[importlinter:contract:repository-access]
name = Repository Protocol Access
type = forbidden
source_modules =
    cleanmast.subdomains.dataprocessing
    cleanmast.subdomains.assessment
allowed_modules =
    cleanmast.subdomains.dataingestion.repositories
    cleanmast.subdomains.dataingestion.value_objects

[importlinter:contract:cli-isolation]
name = CLI Isolation
type = forbidden
source_modules = cleanmast.cli
forbidden_modules =
    cleanmast.subdomains.dataingestion
    cleanmast.subdomains.dataprocessing
    cleanmast.subdomains.assessment
    cleanmast.db.repositories
allowed_modules =
    cleanmast.application

[importlinter:contract:no-circular-imports]
name = No Circular Imports
type = independence
modules = cleanmast

[importlinter:contract:timeseriesdata-creation-gate]
name = TimeSeriesData instantiation restricted to I/O and pipeline modules
type = forbidden
source_modules = 
    cleanmast.subdomains.dataingestion.infrastructure.timeseries_io
    cleanmast.subdomains.dataingestion.repositories.parquet_repository
    cleanmast.application.usecases.execute_fill_heights
allowed_modules = cleanmast.subdomains.dataingestion.entities.time_series_data

[importlinter:contract:entities-package-marker-banned]
name = No import from entities package marker __init__.py
type = forbidden
source_modules = cleanmast
forbidden_modules =
    cleanmast.subdomains.*.entities
    cleanmast.subdomains.*.*.entities

[importlinter:contract:nested-subdomain-isolation]
name = Nested Bounded Context Isolation (assessment)
type = independence
modules =
    cleanmast.subdomains.assessment.subdomains.air_density
    cleanmast.subdomains.assessment.subdomains.extreme_wind
    cleanmast.subdomains.assessment.subdomains.representative_year
    cleanmast.subdomains.assessment.subdomains.turbulence
    cleanmast.subdomains.assessment.subdomains.vertical_profile
    cleanmast.subdomains.assessment.subdomains.weibull
    cleanmast.subdomains.assessment.subdomains.wind_frequency
    cleanmast.subdomains.assessment.subdomains.wind_rose
    cleanmast.subdomains.assessment.subdomains.wind_temporal

