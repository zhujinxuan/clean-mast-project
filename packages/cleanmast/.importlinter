[importlinter]

root_package = cleanmast
include_external_packages = true
exclude_type_checking_imports = true

[importlinter:contract:subdomain-isolation]
name = DDD Bounded Context Isolation
type = independence
modules =
    cleanmast.subdomains.dataingestion
    cleanmast.subdomains.dataprocessing
    cleanmast.subdomains.configuration

[importlinter:contract:domain-purity]
name = Domain Layer Purity
type = forbidden
source_modules =
    cleanmast.shared.timeseries.sensor_column
    cleanmast.shared.timeseries.time_series_source
    cleanmast.shared.timeseries.time_range
    cleanmast.subdomains.dataingestion.entities
    polars
    pandas
    sqlalchemy
    click
    cleanmast.db
    cleanmast.infrastructure

[importlinter:contract:layer-hierarchy]
name = Application Layer Dependencies
type = layers
containers = cleanmast
layers =
    application
    subdomains

[importlinter:contract:repository-access]
name = Repository Protocol Access
type = forbidden
source_modules =
    cleanmast.subdomains.dataprocessing
forbidden_modules =
    cleanmast.subdomains.configuration
    cleanmast.subdomains.reporting

[importlinter:contract:cli-isolation]
name = CLI Isolation
type = forbidden
source_modules = cleanmast.cli
forbidden_modules =
    cleanmast.subdomains.dataingestion
    cleanmast.subdomains.dataprocessing
    cleanmast.db.repositories

[importlinter:contract:no-circular-imports]
name = No Circular Imports
type = independence
modules = cleanmast

[importlinter:contract:timeseriesdata-creation-gate]
name = TimeSeriesData instantiation restricted to I/O and pipeline modules
type = forbidden
source_modules = 
    cleanmast.shared.timeseries.io.file_repository
    cleanmast.application.usecases.execute_fill_heights
allowed_modules = cleanmast.subdomains.dataingestion.entities.time_series_data

[importlinter:contract:entities-package-marker-banned]
name = No import from entities package marker __init__.py
type = forbidden
source_modules = cleanmast
forbidden_modules =
    cleanmast.subdomains.*.entities
    cleanmast.subdomains.*.*.entities

[importlinter:contract:tomli-configuration-gateway-only]
name = Only config_io and sensor-metadata file I/O import tomli/tomli_w
type = forbidden
source_modules =
    cleanmast
forbidden_modules =
    tomli
    tomli_w
ignore_imports =
    cleanmast.subdomains.configuration.services.config_io -> tomli
    cleanmast.subdomains.configuration.services.config_io -> tomli_w
    cleanmast.shared.timeseries.io.file_repository -> tomli
    cleanmast.shared.timeseries.io.file_repository -> tomli_w
