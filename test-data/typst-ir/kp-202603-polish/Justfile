# Default recipe
default:
    @just --list

# Run full polish pipeline
verify:
    @echo "Running DVC polish experiment..."
    cd '{{justfile_directory()}}' && dvc pull
    cd '{{justfile_directory()}}' && uv run python -c "from pathlib import Path; from typst_ir.renderer import render_to_docx; json_str = Path('report.typ.json').read_text(encoding='utf-8'); render_to_docx(json_str, Path('.'))"
    cd '{{justfile_directory()}}' && uv run typst-ir export-mapping --ir-json report.typ.json --docx report.docx --output mapping.json --no-inject
    cd '{{justfile_directory()}}' && uv run typst-ir generate-polish-ir --docx report.docx --config polish.toml --output-ir polish-ir.json
    cd '{{justfile_directory()}}' && uv run typst-ir apply-polish-ir --docx report.docx --polish-ir polish-ir.json --ir-json report.typ.json --output-docx report-polished.docx
    @test -f polish-ir.json && echo "✓ Polish IR generated"
    @test -f report-polished.docx && echo "✓ Polished DOCX generated"

# Clean generated outputs
clean:
    rm -f polish-ir.json report-polished.docx report.docx mapping.json

# Run pipeline manually
run:
    cd '{{justfile_directory()}}' && dvc pull
    cd '{{justfile_directory()}}' && uv run python -c "from pathlib import Path; from typst_ir.renderer import render_to_docx; json_str = Path('report.typ.json').read_text(encoding='utf-8'); render_to_docx(json_str, Path('.'))"
    cd '{{justfile_directory()}}' && uv run typst-ir export-mapping --ir-json report.typ.json --docx report.docx --output mapping.json --no-inject
    cd '{{justfile_directory()}}' && uv run typst-ir generate-polish-ir --docx report.docx --config polish.toml --output-ir polish-ir.json
    cd '{{justfile_directory()}}' && uv run typst-ir apply-polish-ir --docx report.docx --polish-ir polish-ir.json --ir-json report.typ.json --output-docx report-polished.docx

# Show config
config:
    @echo "Experiment: kp-202603-polish"
    @echo "Input IR: report.typ.json"
    @echo "Config: polish.toml"
    @echo "Output DOCX: report.docx"
    @echo "Output Mapping: mapping.json"
    @echo "Output IR: polish-ir.json"
    @echo "Output DOCX: report-polished.docx"
