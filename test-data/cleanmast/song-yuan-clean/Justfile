# Justfile for DVC test dataset: song-yuan-clean
# Step: clean (recommend + process), source: projects/2026-07-02-松原-gate
# Run from repo root: just -f test-data/cleanmast/song-yuan-clean/Justfile verify

set shell := ["nu", "-c"]

DATASET := "song-yuan-clean"
PROJECT := "test-data/cleanmast/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull

# Phase 1: recommend — generates process-clean.toml from raw/ + formats/
recommend:
    cd '{{ROOT}}'; julia bin/CleanMast.jl recommend process-clean '{{PROJECT}}'

# Compare recommend-generated config against truth config
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/process-clean.toml' '{{PROJECT}}/process-clean.toml'

# Phase 2: process — cleans raw/*.parquet into clean/*.parquet using the TRUTH config
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/process-clean.toml' '{{PROJECT}}/process-clean.toml'; julia bin/CleanMast.jl process clean '{{PROJECT}}/process-clean.toml'

# Compare generated clean/*.parquet against truth expected/clean/
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/clean' '{{PROJECT}}/clean'

# Full verification: pull -> recommend -> config check -> process -> output check
verify: pull recommend compare-config process compare-outputs
    @echo "✓ song-yuan-clean verification complete"

# JSON result for cleanmast verify runner
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['clean/M1664.parquet', 'clean/M3142.parquet', 'clean/M5057.parquet', 'clean/M5972.parquet'] if r.returncode == 0 else []; print(json.dumps({'name': 'song-yuan-clean', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/clean' '{{PROJECT}}/process-stats' '{{PROJECT}}/process-clean.toml'
