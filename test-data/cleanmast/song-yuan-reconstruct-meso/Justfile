# Justfile for DVC test dataset: song-yuan-reconstruct-meso
# Step: reconstruct-meso (recommend + override + process), source: projects/2026-07-02-松原-gate
# Run from repo root: just -f test-data/cleanmast/song-yuan-reconstruct-meso/Justfile verify

set shell := ["nu", "-c"]

DATASET := "song-yuan-reconstruct-meso"
PROJECT := "test-data/cleanmast/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull -R .

# Phase 1: recommend — generates reconstruct-meso.toml, then applies override
recommend:
    cd '{{ROOT}}'; julia bin/CleanMast.jl recommend reconstruct-meso '{{PROJECT}}'
    cd '{{ROOT}}'; uv run python '{{PROJECT}}/just-override/override_reconstruct_meso.py'

# Compare recommend+override-generated config against truth config
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/reconstruct-meso.toml' '{{PROJECT}}/reconstruct-meso.toml'

# Phase 2: process — reconstructs using meso models (run on TRUTH config)
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/reconstruct-meso.toml' '{{PROJECT}}/reconstruct-meso.toml'; julia bin/CleanMast.jl process reconstruct-meso '{{PROJECT}}/reconstruct-meso.toml'

# Compare generated reconstruct-meso/*.parquet against truth expected/reconstruct-meso/
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/reconstruct-meso' '{{PROJECT}}/reconstruct-meso'

# Full verification: pull -> recommend -> config check -> process -> output check
verify: pull recommend compare-config process compare-outputs
    @echo "✓ song-yuan-reconstruct-meso verification complete"

# JSON result for cleanmast verify runner
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['reconstruct-meso/M1664.parquet', 'reconstruct-meso/M3142.parquet', 'reconstruct-meso/M5057.parquet', 'reconstruct-meso/M5972.parquet'] if r.returncode == 0 else []; print(json.dumps({'name': 'song-yuan-reconstruct-meso', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/reconstruct-meso' '{{PROJECT}}/reconstruct-meso.toml'
