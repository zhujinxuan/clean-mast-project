# Justfile for DVC test dataset: song-yuan-reconstruct-cross
# Step: reconstruct-cross (recommend + process), source: projects/2026-07-02-松原-gate
# Run from repo root: just -f test-data/cleanmast/song-yuan-reconstruct-cross/Justfile verify

set shell := ["nu", "-c"]

DATASET := "song-yuan-reconstruct-cross"
PROJECT := "test-data/cleanmast/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull

# Phase 1: recommend — generates reconstruct-cross.toml from train-reconstruct-cross/
recommend:
    cd '{{ROOT}}'; julia bin/CleanMast.jl recommend reconstruct-cross '{{PROJECT}}/train-reconstruct-cross/train-results.toml' '{{PROJECT}}'

# Compare recommend-generated config against truth config
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/reconstruct-cross.toml' '{{PROJECT}}/reconstruct-cross.toml' training_metadata.training_date

# Phase 2: process — runs cross-mast reconstruction using the TRUTH config
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/reconstruct-cross.toml' '{{PROJECT}}/reconstruct-cross.toml'; julia bin/CleanMast.jl process reconstruct-cross '{{PROJECT}}/reconstruct-cross.toml'

# Compare generated reconstruct-cross/*.parquet against truth expected/reconstruct-cross/
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/reconstruct-cross' '{{PROJECT}}/reconstruct-cross'

# Full verification: pull -> recommend -> config check -> process -> output check
verify: pull recommend compare-config process compare-outputs
    @echo "✓ song-yuan-reconstruct-cross verification complete"

# JSON result for cleanmast verify runner
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['reconstruct-cross/M1664_reconstructed.parquet', 'reconstruct-cross/M3142_reconstructed.parquet', 'reconstruct-cross/M5057_reconstructed.parquet', 'reconstruct-cross/M5972_reconstructed.parquet'] if r.returncode == 0 else []; print(json.dumps({'name': 'song-yuan-reconstruct-cross', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/reconstruct-cross' '{{PROJECT}}/reconstruct-cross.toml'
