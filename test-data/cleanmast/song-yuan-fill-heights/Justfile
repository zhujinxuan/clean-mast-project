# Justfile for DVC test dataset: song-yuan-fill-heights
# Step: fill-heights (recommend + process), source: projects/2026-07-02-松原-gate
# Run from repo root: just -f test-data/cleanmast/song-yuan-fill-heights/Justfile verify

set shell := ["nu", "-c"]

DATASET := "song-yuan-fill-heights"
PROJECT := "test-data/cleanmast/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull -R .

# Phase 1: recommend — generates fill-heights-reconstruct-meso.toml and fill-heights-representative-year.toml
recommend:
    cd '{{ROOT}}'; uv run cleanmast recommend fill-heights '{{PROJECT}}/'

# Compare both recommend-generated configs against truth configs
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/fill-heights-reconstruct-meso.toml' '{{PROJECT}}/fill-heights-reconstruct-meso.toml'
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/fill-heights-representative-year.toml' '{{PROJECT}}/fill-heights-representative-year.toml'

# Phase 2: process — runs both fill-heights pipelines using the TRUTH configs
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/fill-heights-reconstruct-meso.toml' '{{PROJECT}}/fill-heights-reconstruct-meso.toml'; cp '{{PROJECT}}/expected/fill-heights-representative-year.toml' '{{PROJECT}}/fill-heights-representative-year.toml'; uv run cleanmast fill-heights '{{PROJECT}}/fill-heights-reconstruct-meso.toml'; uv run cleanmast fill-heights '{{PROJECT}}/fill-heights-representative-year.toml'

# Compare generated parquets against truth expected/ dirs
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/reconstruct-meso-fill-heights' '{{PROJECT}}/reconstruct-meso-fill-heights'
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/representative-year-fill-heights' '{{PROJECT}}/representative-year-fill-heights'

# Full verification: pull -> recommend -> config check (process is too long for CI)
verify: pull recommend compare-config
    @echo "✓ song-yuan-fill-heights verification complete"

# JSON result for cleanmast verify runner
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['fill-heights-reconstruct-meso.toml', 'fill-heights-representative-year.toml'] if r.returncode == 0 else []; print(json.dumps({'name': 'song-yuan-fill-heights', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/fill-heights-reconstruct-meso.toml' '{{PROJECT}}/fill-heights-representative-year.toml' '{{PROJECT}}/reconstruct-meso-fill-heights' '{{PROJECT}}/representative-year-fill-heights' '{{PROJECT}}/fill-models'
