# Justfile for DVC test dataset: song-yuan-tower-shading
# Step: tower-shading (recommend + process), source: projects/2026-07-02-松原-gate
# Run from repo root: just -f test-data/cleanmast/song-yuan-tower-shading/Justfile verify

set shell := ["nu", "-c"]

DATASET := "song-yuan-tower-shading"
PROJECT := "test-data/cleanmast/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull -R .

# Phase 1: recommend — generates tower-shading.toml from process-clean.toml
recommend:
    cd '{{ROOT}}'; julia bin/CleanMast.jl recommend tower-shading '{{PROJECT}}'

# Compare recommend-generated config against truth config
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/tower-shading.toml' '{{PROJECT}}/tower-shading.toml'

# Phase 2: process — runs tower-shading correction using the TRUTH config
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/tower-shading.toml' '{{PROJECT}}/tower-shading.toml'; julia bin/CleanMast.jl process tower-shading '{{PROJECT}}/tower-shading.toml'

# Compare generated tower-shading/*.parquet against truth expected/tower-shading/
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/tower-shading' '{{PROJECT}}/tower-shading'

# Full verification: pull -> recommend -> config check -> process -> output check
verify: pull recommend compare-config process compare-outputs
    @echo "✓ song-yuan-tower-shading verification complete"

# JSON result for cleanmast verify runner
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['tower-shading/M1664.parquet', 'tower-shading/M3142.parquet', 'tower-shading/M5057.parquet', 'tower-shading/M5972.parquet'] if r.returncode == 0 else []; print(json.dumps({'name': 'song-yuan-tower-shading', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/tower-shading.toml' '{{PROJECT}}/tower-shading'
