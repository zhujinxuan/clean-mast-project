# Justfile template for DVC step-dataset verification
# Copy this to test-data/{package}/{dataset}/ and customize the step name + commands.
# Template mirrors: test-data/cleanmast/song-yuan-parse-sensors/Justfile
#
# Nushell is required for string interpolation. Install: scoop install nu

set shell := ["nu", "-c"]

DATASET := "{{ dataset-name }}"
PROJECT := "test-data/{{ package }}/" + DATASET
ROOT := clean(justfile_directory() / "../../..")
COMPARE := "test-data/cleanmast/lib/compare_step.py"

default:
    @just --list

# Pull this dataset's DVC-tracked inputs + truth (scoped to dataset dir)
pull:
    cd '{{justfile_directory()}}'; dvc pull -R .

# Phase 1: recommend — generates the step config from input data
# Replace "STEP-NAME" with the actual step name (e.g. parse-sensors, clean, tower-shading, ...)
# Replace "julia bin/CleanMast.jl" with "uv run cleanmast" for Python steps
recommend:
    cd '{{ROOT}}'; julia bin/CleanMast.jl recommend STEP-NAME '{{PROJECT}}'

# Compare recommend-generated config against truth config
compare-config:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' config '{{PROJECT}}/expected/STEP-NAME.toml' '{{PROJECT}}/STEP-NAME.toml'

# Phase 2: process — runs the step using the TRUTH config
# Replace "STEP-NAME" with the actual step name, "project" with "process" or project command
# Replace "julia bin/CleanMast.jl" with "uv run cleanmast" for Python steps
process:
    cd '{{ROOT}}'; cp '{{PROJECT}}/expected/STEP-NAME.toml' '{{PROJECT}}/STEP-NAME.toml'; julia bin/CleanMast.jl project STEP-NAME '{{PROJECT}}/STEP-NAME.toml'

# Compare generated outputs against truth expected/ dir
# Replace "OUTPUT-DIR" with the actual output directory (e.g. raw, clean, filled, ...)
compare-outputs:
    cd '{{ROOT}}'; uv run python '{{COMPARE}}' parquets '{{PROJECT}}/expected/OUTPUT-DIR' '{{PROJECT}}/OUTPUT-DIR'

# Full verification: pull -> recommend -> config check -> process -> output check
verify: pull recommend compare-config process compare-outputs
    @echo "✓ {{ dataset-name }} verification complete"

# JSON result for cleanmast verify runner — produces a single JSON line
# Replace "OUTPUT-FILES" with the list of generated output files
verify-json:
    @cd '{{ROOT}}'; uv run python -c "import json, time, subprocess; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else (r.stdout + r.stderr)[-500:]; outputs = ['OUTPUT-FILES'] if r.returncode == 0 else []; print(json.dumps({'name': '{{ dataset-name }}', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Remove generated outputs (keep DVC-tracked inputs + truth)
# Replace "OUTPUT-DIR" with the actual output directory, "STEP-NAME.toml" with the generated config
clean:
    cd '{{ROOT}}'; rm -rf '{{PROJECT}}/OUTPUT-DIR' '{{PROJECT}}/STEP-NAME.toml'
