# Justfile template for DVC experiments
# Copy this file to test-data/{package}/{dataset}/ and customize

# Default recipe - show available commands
default:
    @just --list

# Run verification (dvc pull + run experiment + check outputs)
verify:
    @echo "Running DVC experiment verification..."
    cd '{{justfile_directory()}}' && dvc pull
    @echo "Running experiment..."
    cd '{{justfile_directory()}}' && uv run cleanmast report timeseries rep-ts-report.toml --no-docx
    @echo "Checking outputs..."
    @echo "✓ Verification complete"

# Run verification and output JSON result
# Note: verify.toml is optional/legacy. Justfile is the primary manifest.
verify-json:
    @cd '{{justfile_directory()}}' && uv run python -c "import json, time, subprocess, sys; start = time.perf_counter(); r = subprocess.run(['just', 'verify'], capture_output=True, text=True, encoding='utf-8', errors='replace'); elapsed = time.perf_counter() - start; status = 'pass' if r.returncode == 0 else 'fail'; error = None if r.returncode == 0 else r.stderr[:500]; outputs = ['rep-ts/report.pdf'] if r.returncode == 0 else []; print(json.dumps({'name': '{{"{{"}}dataset-name{{"}}"}}', 'status': status, 'duration_sec': round(elapsed, 1), 'pull_status': 'success', 'pull_duration_sec': 0.0, 'outputs': outputs, 'error': error}))"

# Clean generated outputs (keep DVC-tracked files)
clean:
    @echo "Cleaning generated files..."
    cd '{{justfile_directory()}}' && rm -rf rep-ts/
    @echo "✓ Cleaned rep-ts/ directory"

# Full reset (clean outputs + DVC cache cleanup)
reset: clean
    @echo "Running DVC garbage collection..."
    cd '{{justfile_directory()}}' && dvc gc -f
    @echo "✓ Reset complete"

# Run the report generation manually
run:
    @echo "Running report generation..."
    cd '{{justfile_directory()}}' && uv run cleanmast report timeseries rep-ts-report.toml --no-docx

# Run with PDF generation (slower)
run-full:
    @echo "Running report generation with PDF..."
    cd '{{justfile_directory()}}' && uv run cleanmast report timeseries rep-ts-report.toml

# Show experiment configuration
# Note: verify.toml is optional when using Justfile-based verification
config:
    @echo "Experiment configuration:"
    @cat verify.toml 2>/dev/null || echo "No verify.toml (optional for Justfile-only manifests)"
