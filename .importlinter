[importlinter]
root_package = cleanmast
include_external_packages = true
exclude_type_checking_imports = true

[importlinter:contract:reporting-pipeline-root]
name = Reporting root pipeline direction
type = layers
containers = cleanmast.subdomains.reporting
layers =
    (api)
    (render)
    (assemble)
    (compute)
    (protocols)
    (model)

[importlinter:contract:reporting-pipeline-capabilities]
name = Reporting capability pipeline direction
type = layers
containers = cleanmast.subdomains.reporting.subdomains.*
layers =
    (api)
    (render)
    (assemble)
    (compute)
    (protocols)
    (model)

[importlinter:contract:reporting-no-cross-context]
name = Reporting cannot import from sibling contexts
type = forbidden
source_modules = cleanmast.subdomains.reporting
forbidden_modules =
    cleanmast.subdomains.dataingestion
allowed_modules =
    cleanmast.shared
    cleanmast.shared.*
ignore_imports =
    cleanmast.subdomains.reporting.subdomains.air_density.compute -> cleanmast.shared.timeseries
    cleanmast.subdomains.reporting.subdomains.air_density.section -> cleanmast.shared.timeseries
    cleanmast.subdomains.reporting.subdomains.representative_year.compute -> cleanmast.shared.timeseries
    cleanmast.subdomains.reporting.subdomains.representative_year.section -> cleanmast.shared.timeseries
    cleanmast.subdomains.reporting.subdomains.wind_temporal.compute -> cleanmast.shared.timeseries
    cleanmast.subdomains.reporting.subdomains.wind_temporal.section -> cleanmast.shared.timeseries

[importlinter:contract:reporting-no-cross-capability]
name = Reporting capabilities cannot import each other
type = independence
modules = cleanmast.subdomains.reporting.subdomains.*
[importlinter:contract:tomli-configuration-gateway-only]
name = No raw TOML I/O — use configuration gateway Pydantic models
type = forbidden
source_modules =
    cleanmast.subdomains.reporting
    cleanmast.application.usecases
    cleanmast.subdomains.dataingestion
    cleanmast.subdomains.dataprocessing
forbidden_modules =
    tomli
    tomli_w
allowed_modules =
    cleanmast.subdomains.configuration
