[importlinter]
root_package = cleanmast
include_external_packages = true
exclude_type_checking_imports = true

[importlinter:contract:reporting-pipeline-root]
name = Reporting root pipeline direction
type = layers
containers = cleanmast.subdomains.reporting
layers =
    (api)
    (render)
    (assemble)
    (compute)
    (protocols)
    (model)
# Spec rule 8 mandates that every capability section renders via
# render/subsection_renderer.py; these edges are the sanctioned exception.
ignore_imports =
    cleanmast.subdomains.reporting.subdomains.air_density.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.extreme_wind.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.representative_year.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.turbulence.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.vertical_profile.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.weibull.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.wind_frequency.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.wind_rose.section -> cleanmast.subdomains.reporting.render.subsection_renderer
    cleanmast.subdomains.reporting.subdomains.wind_temporal.section -> cleanmast.subdomains.reporting.render.subsection_renderer

[importlinter:contract:reporting-pipeline-capabilities]
name = Reporting capability pipeline direction
type = layers
containers = cleanmast.subdomains.reporting.subdomains.*
layers =
    (api)
    (render)
    (assemble)
    (compute)
    (protocols)
    (model)

[importlinter:contract:reporting-no-cross-context]
name = Reporting cannot import from sibling contexts
type = forbidden
source_modules = cleanmast.subdomains.reporting
forbidden_modules =
    cleanmast.subdomains.configuration
    cleanmast.subdomains.dataprocessing
ignore_imports =
    # Sanctioned transitional edges: report TOML types are consumed at the
    # reporting boundary until the report-config schema finds its final home.
    cleanmast.subdomains.reporting.model -> cleanmast.subdomains.configuration.model.report_config
    cleanmast.subdomains.reporting.model.section_node -> cleanmast.subdomains.configuration.model.report_config
    cleanmast.subdomains.reporting.assemble.section_assembler -> cleanmast.subdomains.configuration.model.report_config
    cleanmast.subdomains.reporting.assemble.tree_builder -> cleanmast.subdomains.configuration.model.report_config

[importlinter:contract:reporting-no-cross-capability]
name = Reporting capabilities cannot import each other
type = independence
modules = cleanmast.subdomains.reporting.subdomains.*
[importlinter:contract:tomli-configuration-gateway-only]
name = Only config_io and sensor-metadata file I/O import tomli/tomli_w
type = forbidden
source_modules =
    cleanmast
forbidden_modules =
    tomli
    tomli_w
ignore_imports =
    cleanmast.subdomains.configuration.services.config_io -> tomli
    cleanmast.subdomains.configuration.services.config_io -> tomli_w
    cleanmast.infrastructure.file_repository -> tomli
    cleanmast.infrastructure.file_repository -> tomli_w

[importlinter:contract:no-dev-tools-in-cleanmast]
name = cleanmast must not depend on the dev-tools package
type = forbidden
source_modules = cleanmast
forbidden_modules = cleanmast_dev_tools
